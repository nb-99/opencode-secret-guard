{
  "configVersion": 3,
  "mode": "shell+files",
  "cleanupRoot": null,
  "tools": {
    "git": "/usr/bin/git"
  },
  "secretPatterns": [
    "/\\.env$",
    "/\\.env\\.[^/]*$",
    "\\.pem$",
    "\\.key$",
    "\\.p12$",
    "\\.pfx$",
    "\\.jks$",
    "\\.p8$",
    "\\.keystore$",
    "/id_rsa$",
    "/id_dsa$",
    "/id_ecdsa$",
    "/id_ed25519$",
    "/\\.netrc$",
    "/\\.npmrc$",
    "/\\.pypirc$",
    "/\\.pgpass$",
    "/\\.my\\.cnf$",
    "/\\.git-credentials$",
    "/secrets/",
    "/\\.secrets/",
    "\\.secret$",
    "/secret\\.(json|ya?ml|txt|env|toml)$",
    "[-_.]secret[-_.][^/]*\\.(json|ya?ml|txt|env|toml)$",
    "/credentials$",
    "/credentials\\.(json|ya?ml|toml)$",
    "/kubeconfig$",
    "\\.kubeconfig$",
    "\\.tfstate$",
    "\\.tfstate\\.backup$",
    "\\.tfvars$",
    "/\\.ssh/",
    "/\\.gnupg/",
    "/\\.aws/",
    "/\\.azure/",
    "/\\.kube/",
    "/\\.config/gcloud/",
    "/\\.docker/config\\.json$",
    "/\\.terraform\\.d/credentials\\.tfrc\\.json$",
    "/\\.vault-token$",
    "/\\.config/sops/age/",
    "/\\.config/gh/hosts\\.yml$",
    "/\\.config/glab-cli/",
    "/\\.config/fj/",
    "/\\.config/hub$",
    "/\\.config/github-copilot/",
    "/\\.local/share/opencode/(auth|account)\\.json$"
  ],
  "secretExceptions": [
    "/\\.env\\.(example|sample|template|dist)$",
    "/\\.terraform/terraform\\.tfstate$",
    "^/private/etc/ssl/cert\\.pem$",
    "^/nix/store/"
  ],
  "artifactAllowlist": [
    ".gitignore",
    "node_modules",
    "dist",
    "build",
    "out",
    "target",
    "result",
    ".direnv",
    ".next",
    ".nuxt",
    ".turbo",
    "coverage",
    ".venv",
    "venv",
    "vendor",
    "__pycache__",
    ".gradle",
    ".pytest_cache",
    ".mypy_cache",
    ".terraform"
  ],
  "relaxationGroups": {
    "aws": {
      "allowPaths": [
        ".aws",
        ".terraform.d/credentials.tfrc.json"
      ],
      "allowEnvironment": [
        "^AWS_"
      ],
      "binaries": [
        "aws",
        "terraform",
        "tofu",
        "terragrunt",
        "packer",
        "sam"
      ]
    },
    "azure": {
      "allowPaths": [
        ".azure"
      ],
      "allowEnvironment": [
        "^AZURE_",
        "^ARM_"
      ],
      "binaries": [
        "az"
      ]
    },
    "gcp": {
      "allowPaths": [
        ".config/gcloud"
      ],
      "allowEnvironment": [
        "^GOOGLE_",
        "^CLOUDSDK_"
      ],
      "binaries": [
        "gcloud",
        "gsutil"
      ]
    },
    "kube": {
      "allowPaths": [
        ".kube"
      ],
      "allowEnvironment": [],
      "binaries": [
        "kubectl",
        "helm",
        "k9s",
        "kubectx",
        "kubens",
        "stern",
        "flux",
        "argocd",
        "kustomize"
      ]
    },
    "npm": {
      "allowPaths": [
        ".npmrc"
      ],
      "allowEnvironment": [
        "^NPM_TOKEN$",
        "^NODE_AUTH_TOKEN$"
      ],
      "binaries": [
        "npm",
        "pnpm",
        "yarn",
        "bun",
        "npx"
      ]
    },
    "oci": {
      "allowPaths": [
        ".docker"
      ],
      "allowEnvironment": [],
      "binaries": [
        "docker",
        "podman",
        "nerdctl",
        "skopeo",
        "crane"
      ]
    },
    "ssh": {
      "allowPaths": [
        ".ssh",
        ".gnupg",
        ".git-credentials",
        ".netrc",
        ".config/gh",
        ".config/glab-cli",
        ".config/fj",
        ".config/hub"
      ],
      "allowEnvironment": [
        "^(GH|GITHUB|GITLAB|GLAB|FORGEJO)_TOKEN$"
      ],
      "binaries": [
        "git",
        "ssh",
        "scp",
        "sftp",
        "rsync",
        "gh",
        "glab",
        "fj",
        "fgj",
        "hub",
        "jj"
      ]
    }
  },
  "denyRoots": [
    "~/.config/secrets"
  ],
  "exemptRoots": [],
  "secretEnvironment": [],
  "secretEnvironmentPatterns": [
    "(^|_)(TOKEN|SECRET|PASSWORD|PASSWD|API_KEY|APIKEY|ACCESS_KEY|PRIVATE_KEY|CREDENTIALS?)(_|$)"
  ],
  "cacheTtlMs": 2000
}
