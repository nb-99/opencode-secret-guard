#!/bin/bash
#
# OpenCode's configured shell. It receives `-c <command>`, asks the resolver
# for a sandbox profile, and runs the command under it — unmodified, so the
# command OpenCode displays is the command that ran.
#
# Nothing here is substituted at build time. The resolver is found relative to
# this script, so the package works from a Nix store path, a profile symlink,
# or a plain checkout. Failure is closed at every step: a command never runs
# unsandboxed.
#
# The interpreter is a fixed path, not `/usr/bin/env bash`: PATH commonly holds
# user-writable directories, and a sandboxed command that plants a `bash` there
# would be run unsandboxed by the very next invocation. The Nix build rewrites
# the line to its own bash.
set -uo pipefail

fail() {
  echo "secret-guard: $1" >&2
  exit 1
}

case "$#:${1-}" in
  2:-c) ;;
  *) fail "expected shell invocation: -c <command>" ;;
esac
guarded_command="$2"

here="$(cd -- "$(dirname -- "${BASH_SOURCE[0]}")" && pwd -P)" ||
  fail "cannot locate the package directory"
resolver="$here/../lib/cli.ts"
[[ -f "$resolver" ]] || fail "resolver is missing at $resolver"

# An absolute path, never a PATH lookup: the same planted-binary hole as the
# interpreter line above. The Nix package sets it; a plain checkout must too.
bun="${SECRET_GUARD_BUN-}"
[[ "$bun" == /* && -x "$bun" ]] ||
  fail "set SECRET_GUARD_BUN to the absolute path of bun"

# One invocation returns the profile path on the first line, a hint to print if
# the command fails on the second (empty when there is nothing to say), and the
# environment variables to scrub on the rest. Sandboxing does not unset
# inherited variables, so shell-init secrets would otherwise stay readable via
# printenv. Variable names cannot contain a newline and the policy validator
# enforces that, which is what makes the line-oriented protocol unambiguous.
payload="$("$bun" "$resolver" --resolve "$guarded_command")" || exit 1

profile=""
hint=""
scrub=()
line_number=0
while IFS= read -r line; do
  line_number=$((line_number + 1))
  case "$line_number" in
    1) profile="$line" ;;
    2) hint="$line" ;;
    *) scrub+=(-u "$line") ;;
  esac
done <<<"$payload"

[[ -n "$profile" ]] || fail "profile resolver returned an empty path"

/usr/bin/env ${scrub[@]+"${scrub[@]}"} \
  /usr/bin/sandbox-exec -f "$profile" /bin/zsh -c "$guarded_command"
status=$?

# A command that named a credential binary but ran strict fails deep inside
# that binary with an error naming neither the guard nor the cause. Say why.
if ((status != 0)) && [[ -n "$hint" ]]; then
  echo "$hint" >&2
fi
exit "$status"
