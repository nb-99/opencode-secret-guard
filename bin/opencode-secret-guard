#!/usr/bin/env bash
#
# OpenCode's configured shell. It receives `-c <command>`, asks the resolver
# for a sandbox profile, and runs the command under it — unmodified, so the
# command OpenCode displays is the command that ran.
#
# Nothing here is substituted at build time. The resolver is found relative to
# this script, so the package works from a Nix store path, a profile symlink,
# or a plain checkout. Failure is closed at every step: a command never runs
# unsandboxed.
set -uo pipefail

fail() {
  echo "secret-guard: $1" >&2
  exit 1
}

case "$#:${1-}" in
  2:-c) ;;
  *) fail "expected shell invocation: -c <command>" ;;
esac
guarded_command="$2"

here="$(cd -- "$(dirname -- "${BASH_SOURCE[0]}")" && pwd -P)" ||
  fail "cannot locate the package directory"
resolver="$here/../lib/cli.ts"
[[ -f "$resolver" ]] || fail "resolver is missing at $resolver"

bun="${SECRET_GUARD_BUN:-bun}"
command -v -- "$bun" >/dev/null 2>&1 ||
  fail "bun was not found; set SECRET_GUARD_BUN to its path"

# One invocation returns the profile path on the first line and the environment
# variables to scrub on the following ones. Sandboxing does not unset inherited
# variables, so shell-init secrets would otherwise stay readable via printenv.
# Variable names cannot contain a newline and the policy validator enforces
# that, which is what makes the line-oriented protocol unambiguous.
payload="$("$bun" "$resolver" --resolve "$guarded_command")" || exit 1

profile=""
scrub=()
seen_profile=0
while IFS= read -r line; do
  if ((seen_profile)); then
    scrub+=(-u "$line")
  else
    profile="$line"
    seen_profile=1
  fi
done <<<"$payload"

[[ -n "$profile" ]] || fail "profile resolver returned an empty path"

exec /usr/bin/env ${scrub[@]+"${scrub[@]}"} \
  /usr/bin/sandbox-exec -f "$profile" /bin/zsh -c "$guarded_command"
