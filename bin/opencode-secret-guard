#!/bin/bash
#
# OpenCode's configured shell. It receives `-c <command>`, asks the resolver
# for the sandbox command, and runs the command under it — unmodified, so the
# command OpenCode displays is the command that ran.
#
# Nothing here is substituted at build time. The resolver is found relative to
# this script, so the package works from a Nix store path, a profile symlink,
# or a plain checkout. Failure is closed at every step: a command never runs
# unsandboxed.
#
# The interpreter is a fixed path, not `/usr/bin/env bash`: PATH commonly holds
# user-writable directories, and a sandboxed command that plants a `bash` there
# would be run unsandboxed by the very next invocation. The Nix build rewrites
# the line to its own bash.
set -uo pipefail

fail() {
  echo "secret-guard: $1" >&2
  exit 1
}

case "$#:${1-}" in
  2:-c) ;;
  *) fail "expected shell invocation: -c <command>" ;;
esac
guarded_command="$2"

here="$(cd -- "$(dirname -- "${BASH_SOURCE[0]}")" && pwd -P)" ||
  fail "cannot locate the package directory"
resolver="$here/../lib/cli.ts"
[[ -f "$resolver" ]] || fail "resolver is missing at $resolver"

# An absolute path, never a PATH lookup: the same planted-binary hole as the
# interpreter line above. The Nix package sets it; a plain checkout must too.
bun="${SECRET_GUARD_BUN-}"
[[ "$bun" == /* && -x "$bun" ]] ||
  fail "set SECRET_GUARD_BUN to the absolute path of bun"

# One invocation returns the sandbox command, a hint to print if the command
# fails (empty when there is nothing to say), and the environment variables to
# scrub. The first line is the number N of words in the sandbox command, the
# next N lines are those words, the line after them is the hint, and every
# remaining line names one variable. The hint line is missing when it is empty
# and nothing follows it, because command substitution strips trailing
# newlines. Sandboxing does not unset inherited variables, so shell-init
# secrets would otherwise stay readable via printenv. Neither a word nor a
# variable name can contain a newline, which the resolver enforces; that is
# what makes the line-oriented protocol unambiguous.
#
# The hint's first character says whether it survives a 127 exit: `!` for a
# setuid hint that also applies on 127, `?` for other hints.
payload="$("$bun" "$resolver" --resolve "$guarded_command")" || exit 1

count=""
sandbox=()
hint=""
scrub=()
line_number=0
count_pattern='^[1-9][0-9]?$'
while IFS= read -r line; do
  line_number=$((line_number + 1))
  if ((line_number == 1)); then
    [[ "$line" =~ $count_pattern ]] || fail "resolver returned no sandbox command"
    count="$line"
  elif ((line_number <= count + 1)); then
    sandbox+=("$line")
  elif ((line_number == count + 2)); then
    hint="$line"
  else
    scrub+=(-u "$line")
  fi
done <<<"$payload"

[[ -n "$count" ]] && ((${#sandbox[@]} == count)) ||
  fail "resolver returned an incomplete sandbox command"
# env takes any leading operand containing "=" as an assignment, which would
# run the next word, and so the command, outside the sandbox.
[[ "${sandbox[0]}" == /* && "${sandbox[0]}" != *=* && -x "${sandbox[0]}" ]] ||
  fail "sandbox ${sandbox[0]} is not an absolute path to an executable"

/usr/bin/env ${scrub[@]+"${scrub[@]}"} "${sandbox[@]}" "$guarded_command"
status=$?

# A command that named a credential binary but ran strict fails deep inside
# that binary with an error naming neither the guard nor the cause. Say why.
#
# The shell reports a binary it cannot find as 127 — and also a binary it may
# not execute, which is how a setuid program fails under a sandbox that blocks
# setuid. The status cannot tell the two apart, so the resolver marks which
# hints survive it.
# Both kinds are conditional; neither proves which segment failed.
if ((status != 0)) && [[ -n "$hint" ]]; then
  case "$hint" in
    '!'*) echo "${hint#?}" >&2 ;;
    '?'*) if ((status != 127)); then echo "${hint#?}" >&2; fi ;;
  esac
fi
exit "$status"
